<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Contracts</PackageId>
    
    <BuildNumber>$(GITHUB_RUN_NUMBER)</BuildNumber>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version>1.0.$(BuildNumber)</Version>
    
    <Authors>Aditya</Authors>
    <RepositoryUrl>https://github.com/Aditya-0011/common</RepositoryUrl>

  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.83.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.83.0" />
    <PackageReference Include="ProtoValidate" Version="1.0.1" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
  </ItemGroup>

</Project>